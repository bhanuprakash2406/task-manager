<%
    const pageFilters = typeof filters !== "undefined" && filters
        ? filters
        : {
            search: "",
            status: "",
            priority: "",
            assignedTo: ""
        };

    const pageUsers = typeof users !== "undefined" ? users : [];
    const pageTasks = typeof tasks !== "undefined" ? tasks : [];
    const successMessage = typeof success !== "undefined" ? success : null;
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Tasks | TaskFlow</title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/admin-tasks.css">
</head>
<body>
<div class="dashboard-container">
    <!-- Sidebar -->
       <%- include("../../partials/sidebar.ejs") %>
    <!-- ================= MAIN CONTENT ================= -->
    <main class="main-content">
        <!-- TOPBAR -->
        <header class="topbar">
            <div>
                <h1>All Tasks</h1>
                <p>Manage and monitor all assigned tasks.</p>
            </div>
            <a href="/admin/create-task" class="primary-btn">
                + Create Task
            </a>
        </header>
        <!-- SUCCESS MESSAGE -->
        <% if (successMessage) { %>
            <div class="alert success">
                <%= successMessage %>
            </div>
        <% } %>
        <!-- TASK STATISTICS -->
        <section class="task-summary">
            <div class="summary-card">
                <p>Total Tasks</p>
                <h2><%= pageTasks.length %></h2>
            </div>
            <div class="summary-card">
                <p>Pending</p>
                <h2>
                    <%= pageTasks.filter(task =>
                        task.status === "pending"
                    ).length %>
                </h2>
            </div>
            <div class="summary-card">
                <p>In Progress</p>
                <h2>
                    <%= pageTasks.filter(task =>
                        task.status === "in-progress"
                    ).length %>
                </h2>
            </div>
            <div class="summary-card">
                <p>Completed</p>
                <h2>
                    <%= pageTasks.filter(task =>
                        task.status === "completed"
                    ).length %>
                </h2>
            </div>
        </section>
        <!-- SEARCH & FILTER -->
        <section class="task-filter-card">
            <div class="filter-heading">
                <h2>Search & Filter Tasks</h2>
                <p>
                    Find tasks using title, status, priority or assigned user.
                </p>
            </div>
            <form
                action="/admin/tasks"
                method="GET"
                class="task-filter-form"
            >
                <!-- SEARCH -->
                <div class="filter-group">
                    <label for="search">
                        Search Task
                    </label>
                    <input
                        type="text"
                        id="search"
                        name="search"
                        placeholder="Enter task title..."
                        value="<%= pageFilters.search %>"
                    >
                </div>
                <!-- STATUS -->
                <div class="filter-group">
                    <label for="status">
                        Task Status
                    </label>
                    <select id="status" name="status">
                        <option value="">All Status</option>
                        <option
                            value="pending"
                            <%= pageFilters.status === "pending"
                                ? "selected"
                                : "" %>
                        >
                            Pending
                        </option>
                        <option
                            value="in-progress"
                            <%= pageFilters.status === "in-progress"
                                ? "selected"
                                : "" %>
                        >
                            In Progress
                        </option>
                        <option
                            value="completed"
                            <%= pageFilters.status === "completed"
                                ? "selected"
                                : "" %>
                        >
                            Completed
                        </option>
                    </select>
                </div>
                <!-- PRIORITY -->
                <div class="filter-group">
                    <label for="priority">
                        Priority
                    </label>
                    <select id="priority" name="priority">
                        <option value="">All Priorities</option>
                        <option
                            value="low"
                            <%= pageFilters.priority === "low"
                                ? "selected"
                                : "" %>
                        >
                            Low
                        </option>
                        <option
                            value="medium"
                            <%= pageFilters.priority === "medium"
                                ? "selected"
                                : "" %>
                        >
                            Medium
                        </option>
                        <option
                            value="high"
                            <%= pageFilters.priority === "high"
                                ? "selected"
                                : "" %>
                        >
                            High
                        </option>
                    </select>
                </div>
                <!-- ASSIGNED USER -->
                <div class="filter-group">
                    <label for="assignedTo">
                        Assigned User
                    </label>
                    <select id="assignedTo" name="assignedTo">
                        <option value="">
                            All Users
                        </option>
                        <% pageUsers.forEach(user => { %>
                            <option
                                value="<%= user._id %>"
                                <%= pageFilters.assignedTo === user._id.toString()
                                    ? "selected"
                                    : "" %>
                            >
                                <%= user.name %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                <!-- FILTER BUTTONS -->
                <div class="filter-buttons">
                    <button
                        type="submit"
                        class="filter-search-btn"
                    >
                        Search Tasks
                    </button>
                    <a
                        href="/admin/tasks"
                        class="filter-reset-btn"
                    >
                        Reset Filters
                    </a>
                </div>
            </form>
        </section>
        <!-- TASK MANAGEMENT TABLE -->
        <section class="content-card">
            <div class="section-heading">
                <div>
                    <h2>Task Management</h2>
                    <p>
                        Showing <%= pageTasks.length %> task(s)
                    </p>
                </div>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Task</th>
                            <th>Assigned To</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (pageTasks.length > 0) { %>
                            <% pageTasks.forEach(task => { %>
                                <tr>
                                    <!-- TASK -->
                                    <td class="task-details">
                                        <strong>
                                            <%= task.title %>
                                        </strong>
                                        <small>
                                            <%= task.description || "No description" %>
                                        </small>
                                    </td>
                                    <!-- ASSIGNED USER -->
                                    <td>
                                        <%= task.assignedTo
                                            ? task.assignedTo.name
                                            : "Unknown" %>
                                    </td>
                                    <!-- PRIORITY -->
                                    <td>
                                        <span class="priority <%= task.priority %>">
                                            <%= task.priority %>
                                        </span>
                                    </td>
                                    <!-- STATUS -->
                                    <td>
                                        <span class="status <%= task.status %>">
                                            <%= task.status %>
                                        </span>
                                    </td>
                                    <!-- DUE DATE -->
                                    <td>
                                        <%= task.dueDate
                                            ? new Date(task.dueDate).toLocaleDateString()
                                            : "Not set" %>

                                    </td>
                                    <!-- ACTIONS -->
                                    <td>
                                        <div class="task-actions">
                                            <a
                                                href="/admin/tasks/<%= task._id %>/edit"
                                                class="edit-btn"
                                            >
                                                Edit
                                            </a>
                                            <form
                                                action="/admin/tasks/<%= task._id %>/delete"
                                                method="POST"
                                                onsubmit="return confirm('Are you sure you want to delete this task?')"
                                            >
                                                <button
                                                    type="submit"
                                                    class="delete-btn"
                                                >
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <!-- EMPTY STATE -->
                            <tr>
                                <td colspan="6" class="empty-message">
                                    <div class="empty-state">
                                        <h3>No Tasks Found</h3>
                                        <p>
                                            No tasks match your search or filter.
                                        </p>
                                        <a
                                            href="/admin/create-task"
                                            class="primary-btn"
                                        >
                                            Create New Task
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>
</body>
</html>
